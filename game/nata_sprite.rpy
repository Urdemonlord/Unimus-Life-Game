# Sprite Nata (wajah Arya, tanpa kopiah) + ekspresi.
# Install: salin file ini ke game/nata_sprite.rpy, salin 7 file PNG dari
# folder sprites/ ke game/images/characters/ dengan nama yang sama.
#
# Ukuran tampil standar: zoom 0.80 (ala Summertime Saga, diputuskan Arya
# 2026-11-16; 1.00 terlalu besar dibanding orang di background, 0.65
# terlalu kecil). Zoom sudah menempel di definisi gambar, jadi di scene
# cukup tulis: show nata kemeja
# Sprite tetap 1024x1024 transparan, kaki di bawah, tengah layar.

image nata kemeja:
    "images/characters/nata-kemeja-wajah-arya-v1.png"
    zoom 0.80
    xalign 0.5
    yalign 1.0

